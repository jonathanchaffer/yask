{
  "name": "yask",
  "version": "1.0.0",
  "description": "Template to help kickstart new projects",
  "scripts": {
    "build": "run-s build:*",
    "build:typescript": "tsc && tsc-alias",
    "start": "run-p start:*",
    "start:server": "node dist/app/server.js",
    "dev": "run-p dev:*",
    "dev:server": "npm run build; tsc -w & tsc-alias -w & nodemon dist/app/server.js",
    "test": "run-s test:*",
    "test:unit": "vitest",
    "check": "run-s check:*",
    "check:lint": "eslint .",
    "check:type": "tsc --noEmit",
    "check:format": "prettier --check .",
    "check:deps": "depcruise src",
    "fix": "run-s fix:*",
    "fix:lint": "eslint . --fix",
    "fix:format": "prettier --write .",
    "clean": "rm -rf dist && rm -rf node_modules",
    "migrate": "run-s migrate:*",
    "migrate:reset": "run-s migrate:reset:*",
    "migrate:reset:drizzle": "ts-node -T src/db/drizzle/reset.ts",
    "migrate:create": "run-s migrate:create:*",
    "migrate:create:drizzle": "drizzle-kit generate --config src/db/drizzle/config.ts",
    "migrate:up": "run-s migrate:up:*",
    "migrate:up:drizzle": "drizzle-kit migrate --config src/db/drizzle/config.ts"
  },
  "author": "Jonathan Chaffer",
  "license": "ISC",
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "postgres": "^3.4.7",
    "redis": "^5.10.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^9.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "dependency-cruiser": "^17.3.5",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
